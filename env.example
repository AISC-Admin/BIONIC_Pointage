# --- Base de donnees ---
# Renseignee automatiquement quand vous connectez l'integration Neon
# (Marketplace Postgres) a votre projet Vercel. En local, copiez la valeur
# affichee par Vercel dans .env.local (jamais commite).
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# --- Securite ---
# Mot de passe du responsable pour l'ecran /admin (secours, en plus de
# l'acces nom+code ci-dessous). Choisissez-en un solide.
ADMIN_PASSWORD="changez-moi"

# Identifiant + code qui, saisis sur l'ecran de connexion salarie (page
# d'accueil), ouvrent directement l'espace responsable. Valeurs par defaut
# deja actives dans le code (BIONIC / 809231) : decommentez et changez ces
# deux lignes pour les remplacer avant la mise en production.
# MANAGER_NOM="BIONIC"
# MANAGER_CODE="809231"

# Cle secrete utilisee pour signer les sessions (cookies). Generez une chaine
# aleatoire longue, par exemple avec: openssl rand -base64 48
JWT_SECRET="changez-moi-aussi-une-longue-chaine-aleatoire"
